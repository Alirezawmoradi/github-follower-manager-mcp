{
  "name": "github-follow-manager",
  "version": "1.0.0",
  "description": "A tool to manage GitHub followers using Model Context Protocol pattern",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/mcp-server.js",
    "setup": "npm install && npm run build",
    "watch": "nodemon --watch 'src/**/*' --ext 'ts,json' --exec 'ts-node src/mcp-server.ts'"
  },
  "keywords": [
    "github",
    "api",
    "typescript",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^18.11.9",
    "axios": "^1.6.0",
    "dotenv": "^16.0.3",
    "inquirer": "^8.2.5",
    "octokit": "^2.0.14",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
